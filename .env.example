# Copy to .env for local use, or paste into the Environment tab in Dokploy / Coolify.
# Generate secrets with:  openssl rand -hex 24
# Use URL-safe secrets (hex/base64url) — no quotes, spaces, '$', or '#'.

# ── Required secrets ─────────────────────────────────────────────
POSTGRES_PASSWORD=
REPLICATION_PASSWORD=
PGBOUNCER_AUTH_PASSWORD=
PGBOUNCER_ADMIN_PASSWORD=
MONITOR_PASSWORD=
# Encrypts every backup. STORE A COPY OUTSIDE THIS SERVER: without it backups are unreadable.
# Cannot be changed after the first backup repository is created.
BACKUP_CIPHER_PASS=

# ── First application database (optional; only applied on first init) ──
APP_DB_NAME=
APP_DB_USER=
APP_DB_PASSWORD=

# ── Images (defaults to pre-built Docker Hub images) ─────────────
POSTGRES_IMAGE=andreastuko/vps-postgres:17
PGBOUNCER_IMAGE=andreastuko/vps-pgbouncer:1

# ── Optional profiles: replica, monitoring (comma separated) ─────
COMPOSE_PROFILES=
REPLICA_SLOT=replica1
PRIMARY_HOST=postgres-primary

# ── Exposure ─────────────────────────────────────────────────────
# 127.0.0.1 = reachable only from the VPS itself. Use 0.0.0.0 to publish PgBouncer.
PGBOUNCER_BIND=127.0.0.1
PGBOUNCER_PORT=6432
# Docker-internal ranges allowed to connect to Postgres directly (never published to the host).
PG_ALLOWED_CIDRS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# Allow superuser (postgres) network access. Recommended: no (use create-app-db or APP_DB_USER instead).
PG_ALLOW_REMOTE_SUPERUSER=no

# ── TLS (base64 of PEM files; blank = self-signed, regenerated on container recreate) ──
# base64 -w0 fullchain.pem
TLS_CERT_B64=
TLS_KEY_B64=

# ── Postgres sizing (rule of thumb for a dedicated host: 25% RAM / 75% RAM) ──
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_MAX_WAL_SIZE=4GB
# Caps WAL retained for a stalled replica so it can never fill the disk.
PG_MAX_SLOT_WAL_KEEP_SIZE=20GB
PG_LOG_MIN_DURATION_MS=1000

# ── PgBouncer ────────────────────────────────────────────────────
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=20
# Keep below PG_MAX_CONNECTIONS to leave room for admin/replication/exporter sessions.
PGBOUNCER_MAX_DB_CONNECTIONS=100
PGBOUNCER_MAX_PREPARED_STATEMENTS=100

# ── Backups (pgBackRest) ─────────────────────────────────────────
BACKUP_ENABLED=yes
BACKUP_FULL_CRON=0 2 * * 0
BACKUP_DIFF_CRON=0 2 * * 1-6
BACKUP_RETENTION_FULL=4
BACKUP_RETENTION_DIFF=14
# Off-site copy (strongly recommended — the local repo lives on the same server):
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=s3.eu-central-1.amazonaws.com
BACKUP_S3_REGION=eu-central-1
BACKUP_S3_KEY=
BACKUP_S3_KEY_SECRET=
BACKUP_S3_URI_STYLE=host
BACKUP_S3_PATH=/pgbackrest
